{
  "name": "path-fast",
  "version": "2.0.0",
  "description": "A CLI tool designed to streamline access to projects.",
  "main": "dist/index.js",
  "type": "module",
  "private": false,
  "bin": {
    "pf": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "dev:pf": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run",
    "docker:build": "docker compose -f docker/compose.yml build",
    "docker:shell": "docker compose -f docker/compose.yml run --rm pf-e2e bash",
    "docker:down": "docker compose -f docker/compose.yml down"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/path-fast/core.git"
  },
  "bugs": {
    "url": "https://github.com/path-fast/core/issues"
  },
  "author": "Eduardo Nicola eduardonicolagit@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/path-fast/core#readme",
  "keywords": [
    "cli",
    "path",
    "shortcut",
    "project-management",
    "automation",
    "vscode"
  ],
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.26.2"
}
